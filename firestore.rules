rules_version = '2';

// Home is shared by the two of you: both accounts read and write everything.
// Sign-ups are turned off in Firebase (Authentication -> Settings), so the
// only accounts that can exist are the ones added in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /things/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
